# Copy to `.env` for local development. Never commit real values.
# Source of truth for these names: the code that reads them (listed beside each).

# ── Browser build (Vite): these ARE shipped to the browser, so only public values belong here ──
# src/lib/supabase.js (it also hard-codes a fallback project URL and public anon key)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON=<public anon key from Supabase → Project Settings → API>
# src/lib/ai.jsx: delay before the single AI retry, in ms (optional, default 600)
VITE_LLM_RETRY_DELAY_MS=600
# STAR stories and mock interviews are scored by the score-star / score-interview Edge Functions (finding F-1). On unless this is 'false'.
# 'false' only works while the browser may still write the score tables (before server-only-score-writes.sql).
VITE_SERVER_SCORING=true

# ── Supabase Edge Function secrets: set with `supabase secrets set ...`, NEVER in a VITE_ variable ──
# SUPABASE_URL and SUPABASE_ANON_KEY are injected by Supabase automatically.

# supabase/functions/ai (providers.js, handler.js)
AI_PROVIDER=anthropic            # anthropic | gemini | openai; falls back to the first provider that has a key
AI_MODEL=                        # optional; ignored if it does not match the chosen provider's model family
ANTHROPIC_API_KEY=
GEMINI_API_KEY=                  # optional
OPENAI_API_KEY=                  # optional
GROQ_API_KEY=                    # optional, free tier, OpenAI-compatible fallback (no PDF support). GROQ_MODEL overrides the default model
OPENROUTER_API_KEY=              # optional, has free models, OpenAI-compatible fallback (no PDF support). OPENROUTER_MODEL overrides the default
DEEPINFRA_API_KEY=              # optional, paid but cheap, OpenAI-compatible fallback (no PDF). DEEPINFRA_MODEL overrides the default
MISTRAL_API_KEY=                 # optional, OpenAI-compatible fallback (no PDF). Use a PAID or training-opted-out account for user data. MISTRAL_MODEL overrides
AI_FALLBACKS=                    # optional, comma list, e.g. groq,openrouter. Default: every provider that has a key

# supabase/functions/jobs (handler.js)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# supabase/functions/ai, jobs, verify-cert: comma-separated allowed browser origins
# (if empty, CORS answers "*")
ALLOWED_ORIGINS=https://careeraihub.com,https://www.careeraihub.com
