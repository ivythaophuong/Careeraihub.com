node_modules
dist
.git
coverage
*.log

# Secrets and local state must never enter the build context (and therefore the image).
# .env.production is excluded too: a build without it is byte-identical to production.
.env
.env.*
*.pem
.mcp.json
.claude

# Not build inputs
# Edge Function sources stay out, except the pure rules the browser bundle imports (src/features/STARBuilder/star.js).
supabase/*
!supabase/functions/
supabase/functions/*
!supabase/functions/_shared/
tests
docs
scripts
**/*.test.js
**/*.test.jsx
*.md
